<Window x:Class="HanoiTowers.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ханойские башни" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BgWindowBrush}">
    <Border Background="{StaticResource BgCardBrush}" CornerRadius="20"
            Margin="26" Padding="30">
        <StackPanel>

            <TextBlock Text="Ханойские башни" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Перенесите все кольца со стержня A на стержень C. За раз можно переместить только верхнее кольцо, а большее кольцо нельзя класть на меньшее."/>

            <!-- Выбор количества колец -->
            <Border Background="{StaticResource BgPanelBrush}" CornerRadius="12"
                    Padding="16,14" Margin="0,20,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Количество колец" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="tbDiskCount" HorizontalAlignment="Right"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <Slider x:Name="sliderDisks" Minimum="3" Maximum="10" Value="3"
                            Style="{StaticResource ModernSlider}" Margin="0,12,0,0"/>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="3" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="10" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Минимальное число ходов -->
            <Border Background="{StaticResource BgPanelDarkBrush}" CornerRadius="12"
                    Padding="18,12" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="tbMinMoves" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center" MinWidth="46"/>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="минимальное число ходов" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="tbMinFor" FontSize="13" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button x:Name="btnNewGame" Content="Новая игра"
                        Style="{StaticResource BtnAccent}" Width="165" Height="44"
                        FontSize="14.5" Click="BtnNewGame_Click"/>
                <Button x:Name="btnContinue" Content="Продолжить игру"
                        Style="{StaticResource BtnGhost}" Width="170" Height="44"
                        FontSize="14" Margin="12,0,0,0"
                        IsEnabled="False" Click="BtnContinue_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>